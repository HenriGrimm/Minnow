erText,\r\n  parseSlashCommand,\r\n  resolveActiveSkill,\r\n  resolveTurnSkill,\r\n} from '../skills';\r\nimport { UI_DESIGNER_AGENT_ID } from '../agents/ui-designer/constants';\r\nimport {\r\n  augmentSkillBodyForUiDesigner,\r\n  prepareUiDesignerTurn,\r\n} from '../agents/ui-designer/runner';\r\nimport { applyModelSelectValueToChat } from '../lib/model-select-key';\r\nimport {\r\n  resolveEffectiveChatModelBinding,\r\n  syncPerChatModelBindingFromCatalog,\r\n} from '../ui/default-model';\r\nimport {\r\n  clearComposerAfterSend,\r\n  clearComposerDraftOnChat,\r\n  beginComposerSubmissionDraft,\r\n  type ComposerSubmissionDraft,\r\n} from '../ui/composer-draft';\r\nimport {\r\n  resolveComposerSurface,\r\n  type ComposerSurface,\r\n} from '../ui/composer-surface';\r\nimport { refreshComposerStreamingAffordance, syncComposerFromStreamingState } from '../ui/composer-send';\r\nimport { syncComposerMessageQueue } from '../ui/composer-message-queue';\r\nimport { syncGoalActiveHint } from '../ui/goal-active-hint';\r\nimport { syncLoopActiveHint } from '../ui/loop-active-hint';\r\nimport { syncFollowupActiveHint } from '../ui/followup-active-hint';\r\nimport { syncTodoPanel } from '../ui/todo-panel';\r\nimport { syncComposerPinnedSkillFromActiveChat } from '../ui/composer-pinned-skill';\r\nimport { getPickerAppliedSkillId } from '../ui/skill-picker';\r\nimport { setStatus } from '../ui/status';\r\nimport type { Chat, CodeMapMessageSnapshot, IssueMessageSnapshot } from '../types';\r\nimport { dispatchPluginSlashCommand, isPluginSlashCommand } from './slash-commands/registry';\r\nimport { getWorkspacePath } from '../state/workspace';\r\nimport { isPairedDevice } from '../api/session-token';\r\nimport { sendRemoteChatCommand, shouldRelayChat } from './remote-chat-client';\r\nimport type { ChatSendIntent } from '../../server/chats/contracts';\r\nimport { isCavemanIntensity } from '../skills/caveman-client';\r\nimport { ensureOrdinaryChatRoute } from './ordinary-routing';\r\nimport { beginFirstMessageSubmission, finishFirstMessageSubmission, getFirstMessageSubmission, isFirstMessageSubmissionPending, releaseFirstMessageSubmission } from './first-message-submission';\r\nimport { renderChatFromHistory, syncPendingTranscriptMessages } from '../ui/messages';\r\nimport { randomUUID } from '../lib/random-id';\r\n\r\nexport {\r\n  buildApiMessages,\r\n  buildHistoryUserContent,\r\n  buildVlmUserApiContent,\r\n  persistableUserImages,\r\n} from './build-api-messages';\r\nexport {\r\n  runChatTurn,\r\n  resumeParentChatWithMessage,\r\n} from './run-turn-chat';\r\n\r\nasync function persistPairedChatBeforeSend(chat: Chat): Promise<void> {\r\n  if (chat.history.length || getDurablySavedChatRevision(chat.id) !== null) return;\r\n  // Device drafts are local. A newly created chat needs its own shared row\r\n  // before the computer can look up the target of the first send.\r\n  markChatDirty(chat);\r\n  if (!await persistSessionsBeforeDeliveryAck(chat.id) || getDurablySavedChatRevision(chat.id) === null) {\r\n    throw new Error('Could not save the new chat.');\r\n  }\r\n}\r\nexport type { RunChatTurnOptions, ResumeParentChatOptions } from './run-turn-chat';\r\nexport type { ComposerSurface } from '../ui/composer-surface';\r\nexport { resendFromIndex } from './resend-from-index';\r\nexport {\r\n  truncateChatHistory,\r\n  updateUserMessageAt,\r\n} from './history-truncate';\r\n/** Non-tool send (legacy / internal). */\r\nexport { sendMessage as sendMessagePlain } from '../api/chat';\r\n\r\n// ── Options ──────────────────────────────────────────────────────────────────\r\n\r\n/** Send the composer text with tool calling. */\r\nexport interface ComposerSendOptions extends Partial<ComposerSurface> {\r\n  /** Mid-turn messages steer by default; explicit queue actions wait for turn end. */\r\n  followupDelivery?: 'steer' | 'queue';\r\n  /** Surface-owned context injected for this turn without adding it to chat history. */\r\n  ephemeralContext?: string;\r\n  /** Programmatic issue seed rendered as a dedicated ticket. */\r\n  issue?: IssueMessageSnapshot;\r\n}\r\n\r\n/** Options for {@link sendProgrammaticChatText}. */\r\nexport interface SendProgrammaticChatTextOptions {\r\n  signal?: AbortSignal;\r\n  clearComposerOnSend?: boolean;\r\n  onUserMessageAccepted?: () => Promise<void>;\r\n  codeMap?: CodeMapMessageSnapshot;\r\n  goalDriven?: boolean;\r\n  suppressUserEcho?: boolean;\r\n  ephemeralContext?: string;\r\n  validAttachments?: Attachment[];\r\n  composerSurface?: Partial<ComposerSurface>;\r\n  parseSlash?: boolean;\r\n  /** The calling workflow depends on this skill and must not run without it. */\r\n  requiredSkillId?: string;\r\n  /** Reject a handoff if its turn could not run to completion. */\r\n  requireCompletedTurn?: boolean;\r\n  /** Pre-adjusted slash input (orchestrate plan injection); defaults to `text`. */\r\n  slashInput?: string;\r\n  titleSeed?: string;\r\n  deferTitleUntilTurnEnd?: boolean;\r\n  ownsGlobalStreaming?: boolean;\r\n  /** Programmatic issue seed rendered as a dedicated ticket. */\r\n  issue?: IssueMessageSnapshot;\r\n  /** Attach `<issue-ref>` context for issue ids the user typed (composer sends only). */\r\n  attachIssueMentions?: boolean;\r\n  /** Report status errors (defaults to setStatus). */\r\n  reportStatus?: (level: 'ok' | 'err', message: string) => void;\r\n}\r\n\r\n// ── Programmatic ─────────────────────────────────────────────────────────────\r\n\r\n/** The renderer selects identities; only the server resolves their instruction bodies. */\r\nfunction managedSendContext(chat: Chat, text: string, options: SendProgrammaticChatTextOptions) {\r\n  const slash = options.requiredSkillId || options.parseSlash === false\r\n    ? { skillId: options.requiredSkillId ?? null, userText: (options.slashInput ?? text).trim() }\r\n    : parseSlashCommand(options.slashInput ?? text);\r\n  if (slash.skillId && !isSkillEnabled(slash.skillId)) throw new Error(`Skill \"${slash.skillId}\" is