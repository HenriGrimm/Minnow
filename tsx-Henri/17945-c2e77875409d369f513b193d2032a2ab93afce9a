{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});const BENCHMARK_THINKING_TIME_SHARE=.4;const BENCHMARK_FALLBACK_TOK_PER_SEC=16;const MIN_BENCHMARK_THINKING_TOKENS=384;const MAX_BENCHMARK_THINKING_TOKENS=8192;function resolveBenchmarkThinkingBudgetTokens(input){const timeoutMs=input.timeoutMs;if(!timeoutMs||!Number.isFinite(timeoutMs)||timeoutMs<=0){return MAX_BENCHMARK_THINKING_TOKENS}const rate=input.tokPerSec!=null&&Number.isFinite(input.tokPerSec)&&input.tokPerSec>0?input.tokPerSec:BENCHMARK_FALLBACK_TOK_PER_SEC;const allowance=timeoutMs/1e3*rate*BENCHMARK_THINKING_TIME_SHARE;return Math.min(MAX_BENCHMARK_THINKING_TOKENS,Math.max(MIN_BENCHMARK_THINKING_TOKENS,Math.round(allowance)))}__name(resolveBenchmarkThinkingBudgetTokens,\"resolveBenchmarkThinkingBudgetTokens\");const THROUGHPUT_SMOOTHING=.5;const observedTokPerSec=new Map;function throughputKey(providerId,modelId){return`${providerId}::${modelId}`}__name(throughputKey,\"throughputKey\");function recordBenchmarkThroughput(providerId,modelId,tokPerSec){if(tokPerSec==null||!Number.isFinite(tokPerSec)||tokPerSec<=0)return;const key=throughputKey(providerId,modelId);const prior=observedTokPerSec.get(key);observedTokPerSec.set(key,prior==null?tokPerSec:prior*(1-THROUGHPUT_SMOOTHING)+tokPerSec*THROUGHPUT_SMOOTHING)}__name(recordBenchmarkThroughput,\"recordBenchmarkThroughput\");function getBenchmarkThroughput(providerId,modelId){return observedTokPerSec.get(throughputKey(providerId,modelId))??null}__name(getBenchmarkThroughput,\"getBenchmarkThroughput\");function resetBenchmarkThroughput(){observedTokPerSec.clear()}__name(resetBenchmarkThroughput,\"resetBenchmarkThroughput\");export{BENCHMARK_FALLBACK_TOK_PER_SEC,BENCHMARK_THINKING_TIME_SHARE,MAX_BENCHMARK_THINKING_TOKENS,MIN_BENCHMARK_THINKING_TOKENS,getBenchmarkThroughput,recordBenchmarkThroughput,resetBenchmarkThroughput,resolveBenchmarkThinkingBudgetTokens};\n","warnings":[],"map":{"version":3,"mappings":"kHAWO,MAAM,8BAAgC,GAOtC,MAAM,+BAAiC,GAGvC,MAAM,8BAAgC,IAGtC,MAAM,8BAAgC,KAatC,SAAS,qCACd,MACQ,CACR,MAAM,UAAY,MAAM,UACxB,GAAI,CAAC,WAAa,CAAC,OAAO,SAAS,SAAS,GAAK,WAAa,EAAG,CAC/D,OAAO,6BACT,CAEA,MAAM,KACJ,MAAM,WAAa,MAAQ,OAAO,SAAS,MAAM,SAAS,GAAK,MAAM,UAAY,EAC7E,MAAM,UACN,+BAEN,MAAM,UAAa,UAAY,IAAQ,KAAO,8BAC9C,OAAO,KAAK,IACV,8BACA,KAAK,IAAI,8BAA+B,KAAK,MAAM,SAAS,CAAC,CAC/D,CACF,CAlBgB,oFAqBhB,MAAM,qBAAuB,GAE7B,MAAM,kBAAoB,IAAI,IAE9B,SAAS,cAAc,WAAoB,QAAyB,CAClE,MAAO,GAAG,UAAU,KAAK,OAAO,EAClC,CAFS,sCAKF,SAAS,0BACd,WACA,QACA,UACM,CACN,GAAI,WAAa,MAAQ,CAAC,OAAO,SAAS,SAAS,GAAK,WAAa,EAAG,OACxE,MAAM,IAAM,cAAc,WAAY,OAAO,EAC7C,MAAM,MAAQ,kBAAkB,IAAI,GAAG,EACvC,kBAAkB,IAChB,IACA,OAAS,KAAO,UAAY,OAAS,EAAI,sBAAwB,UAAY,oBAC/E,CACF,CAZgB,8DAeT,SAAS,uBAAuB,WAAoB,QAAgC,CACzF,OAAO,kBAAkB,IAAI,cAAc,WAAY,OAAO,CAAC,GAAK,IACtE,CAFgB,wDAKT,SAAS,0BAAiC,CAC/C,kBAAkB,MAAM,CAC1B,CAFgB","names":[],"ignoreList":[],"sources":["C:\\Users\\dukky\\Documents\\Development\\Minnow\\src\\benchmark\\thinking-budget-policy.ts"],"sourcesContent":["/**\r\n * Wall-clock-aware thinking budget for benchmark probes.\r\n *\r\n * Chat's flat 8192-token budget is throughput-blind. At the ~16 tok/s a local 27B streams,\r\n * 8192 reasoning tokens need ~512s of contiguous thinking, so a 300s probe timeout always\r\n * fires first: the watchdog can never trip, the probe is killed with no output, and the row\r\n * scores `fail` with an empty transcript. Size the budget from the time the probe actually\r\n * has instead, using the rate the run has observed for that target.\r\n */\r\n\r\n/** Share of a probe's wall clock that may go to reasoning before the watchdog trips. */\r\nexport const BENCHMARK_THINKING_TIME_SHARE = 0.4;\r\n\r\n/**\r\n * Stream rate assumed before this run has measured one. Deliberately low — guessing fast\r\n * on a slow host reproduces the bug this module exists to fix, while guessing slow only\r\n * costs a little reasoning headroom on the first probe.\r\n */\r\nexport const BENCHMARK_FALLBACK_TOK_PER_SEC = 16;\r\n\r\n/** Floor: below this a reasoning model cannot finish even a short deliberation. */\r\nexport const MIN_BENCHMARK_THINKING_TOKENS = 384;\r\n\r\n/** Ceiling: chat's flat budget, used when no timeout bounds the call. */\r\nexport const MAX_BENCHMARK_THINKING_TOKENS = 8192;\r\n\r\nexport interface ResolveBenchmarkThinkingBudgetInput {\r\n  /** Probe wall-clock budget; omitted for suites that run without a timeout. */\r\n  timeoutMs?: number;\r\n  /** Observed stream rate for this target, when the run has one. */\r\n  tokPerSec?: number | null;\r\n}\r\n\r\n/**\r\n * Tokens of reasoning a probe may spend before the watchdog makes it commit.\r\n * Without a timeout there is nothing to derive from, so fall back to chat's budget.\r\n */\r\nexport function resolveBenchmarkThinkingBudgetTokens(\r\n  input: ResolveBenchmarkThinkingBudgetInput,\r\n): number {\r\n  const timeoutMs = input.timeoutMs;\r\n  if (!timeoutMs || !Number.isFinite(timeoutMs) || timeoutMs <= 0) {\r\n    return MAX_BENCHMARK_THINKING_TOKENS;\r\n  }\r\n\r\n  const rate =\r\n    input.tokPerSec != null && Number.isFinite(input.tokPerSec) && input.tokPerSec > 0\r\n      ? input.tokPerSec\r\n      : BENCHMARK_FALLBACK_TOK_PER_SEC;\r\n\r\n  const allowance = (timeoutMs / 1000) * rate * BENCHMARK_THINKING_TIME_SHARE;\r\n  return Math.min(\r\n    MAX_BENCHMARK_THINKING_TOKENS,\r\n    Math.max(MIN_BENCHMARK_THINKING_TOKENS, Math.round(allowance)),\r\n  );\r\n}\r\n\r\n/** Smoothing on observed rates so one slow prompt-processing turn does not dominate. */\r\nconst THROUGHPUT_SMOOTHING = 0.5;\r\n\r\nconst observedTokPerSec = new Map<string, number>();\r\n\r\nfunction throughputKey(providerId: string, modelId: string): string {\r\n  return `${providerId}::${modelId}`;\r\n}\r\n\r\n/** Record a completed turn's stream rate for later budget sizing. */\r\nexport function recordBenchmarkThroughput(\r\n  providerId: string,\r\n  modelId: string,\r\n  tokPerSec: number | null | undefined,\r\n): void {\r\n  if (tokPerSec == null || !Number.isFinite(tokPerSec) || tokPerSec <= 0) return;\r\n  const key = throughputKey(providerId, modelId);\r\n  const prior = observedTokPerSec.get(key);\r\n  observedTokPerSec.set(\r\n    key,\r\n    prior == null ? tokPerSec : prior * (1 - THROUGHPUT_SMOOTHING) + tokPerSec * THROUGHPUT_SMOOTHING,\r\n  );\r\n}\r\n\r\n/** Observed stream rate for a target, or null before the run has measured one. */\r\nexport function getBenchmarkThroughput(providerId: string, modelId: string): number | null {\r\n  return observedTokPerSec.get(throughputKey(providerId, modelId)) ?? null;\r\n}\r\n\r\n/** Clear observed rates (tests, and between campaigns). */\r\nexport function resetBenchmarkThroughput(): void {\r\n  observedTokPerSec.clear();\r\n}\r\n"]}}