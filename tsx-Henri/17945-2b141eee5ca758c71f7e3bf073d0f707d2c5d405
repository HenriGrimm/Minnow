KAClC,QAAS,IAAI,QACb,kBAAmB,IAAI,kBACvB,aAAc,IAAI,aAClB,MAAO,IAAI,OAAS,KACpB,UAAW,IAAI,WAAa,KAC5B,QAAS,IAAI,SAAW,KACxB,UAAW,IAAI,UACf,UAAW,IAAI,SAAW,YAC1B,SAAU,IAAI,SACd,SAAU,IAAI,SACd,YAAa,IAAI,WACnB,CACF,CApCS,8DAsCT,eAAsB,6BAA6B,aAAsB,CACvE,GAAI,CAAC,UAAU,QAAQ,WAAY,CACjC,OAAO,OAAO,CAAC,CAAC,CAClB,CACA,OAAO,OAAQ,MAAM,SAAS,QAAQ,WAAW,YAAY,GAAM,CAAC,CAAC,CACvE,CALsB","names":[],"ignoreList":[],"sources":["C:\\Users\\dukky\\Documents\\Development\\Minnow\\src\\agents\\sub-agent-completion-push.ts"],"sourcesContent":["import { normalizeModeId } from '../chat/modes/types';\r\nimport { buildSubAgentParentResumeMessage } from './sub-agent-resume-message';\r\nimport { isChatStreaming, subscribeChatStreamEnd } from '../chat/streaming-state';\r\nimport { reportBackgroundError } from '../boot/report-background-error';\r\nimport { findChatById, recordChatMessage, touchChat } from '../state/sessions';\r\nimport { hiddenTranscriptUserMessage } from '../chat/hidden-transcript-user-messages';\r\nimport { isResumeGateHeld } from '../chat/resume-gate';\r\nimport { isChatTurnInProgress } from '../chat/chat-turn-guard';\r\nimport type { PersistedSubAgentRun } from '../types';\r\nimport {\r\n  acknowledgeSubAgentDelivery,\r\n  getSubAgentRun,\r\n  subscribeSubAgentDeliver,\r\n} from './orchestrator';\r\nimport { isSubAgentRunTerminal } from './sub-agent-outcome';\r\nimport { subscribeSubAgentRuns } from './sub-agent-events';\r\nimport type { SubAgentRun } from './types';\r\nimport { createDelivery, createMemoryJournal } from '../../server/sub-agents/delivery.js';\r\nimport { derive, isTerminal, lastEndedAttempt } from '../../server/sub-agents/derive.js';\r\nimport { makeEvent } from '../../server/sub-agents/events.js';\r\nimport type { DeliveryHandle, ParentStatus } from '../../server/sub-agents/delivery.js';\r\nimport type { RunState } from '../../server/sub-agents/types';\r\nimport type { DeliverFrame } from './sub-agent-client';\r\n\r\nlet pushInitialized = false;\r\nlet ingestChain: Promise<void> = Promise.resolve();\r\n\r\ntype CompletionDeliverFn = (\r\n  chatId: string,\r\n  message: string,\r\n  runIdsToMark: string[],\r\n) => Promise<void>;\r\n\r\ntype CompletionNotifyFn = (chatId: string, run: SubAgentRun) => void;\r\n\r\nlet deliverHook: CompletionDeliverFn | null = null;\r\nlet notifyHook: CompletionNotifyFn | null = null;\r\n\r\nlet delivery: DeliveryHandle | null = null;\r\n\r\nconst delayedByChat = new Map<string, Array<DeliverFrame & { parentChatId: string }>>();\r\nconst queuedDeliveryKeys = new Set<string>();\r\nconst resumedDeliveryKeys = new Set<string>();\r\n\r\n// A turn can win admission after a delivery frame was queued. Leave its\r\n// result unacknowledged for the server's next offer without reporting an error.\r\nclass ParentChatDeliveryDeferredError extends Error {}\r\n\r\nfunction hasManagedParent(chatId: string): boolean {\r\n  const chat = findChatById(chatId);\r\n  return chat?.chatCommandVersion === 1 || Boolean(chat?.agentConversation);\r\n}\r\n\r\nfunction deliveryKey(frame: DeliverFrame & { parentChatId: string }): string {\r\n  return `${frame.parentChatId}:${[...frame.runIds].sort().join(',')}`;\r\n}\r\n\r\nfunction hasPersistentBinding(parentChatId: string, runId: string, run?: SubAgentRun): boolean {\r\n  return Boolean(run?.childChatId || getSubAgentRun(runId)?.childChatId ||\r\n    findChatById(parentChatId)?.subAgentRuns?.find(row => row.runId === runId)?.childChatId);\r\n}\r\n\r\n/** The durable task service alone publishes results for canonical child chats. */\r\nfunction legacyDeliveryFrame(frame: DeliverFrame & { parentChatId: string }): (DeliverFrame & { parentChatId: string }) | null {\r\n  const runIds = frame.runIds.filter(id => !hasPersistentBinding(frame.parentChatId, id));\r\n  if (runIds.length === frame.runIds.length) return frame;\r\n  if (!runIds.length) return null;\r\n  const runs = runIds.map(id => resolveSubAgentRunForParentSession(id, frame.parentChatId));\r\n  if (!runs.every((run): run is SubAgentRun => run !== undefined)) return null;\r\n  const message = frame.kind === 'check_in_nudge'\r\n    ? buildSubAgentParentResumeMessage(frame.kind, runs, { run: runs[0], elapsedSec: elapsedSeconds(runs[0]) })\r\n    : buildSubAgentParentResumeMessage(frame.kind, runs);\r\n  return { ...frame, runIds, message };\r\n}\r\n\r\n// ── Adapter ──────────────────────────────────────────────────────────────────\r\n\r\nfunction createAdapterDelivery(): DeliveryHandle {\r\n  const journal = createMemoryJournal();\r\n  return createDelivery({\r\n    journal,\r\n    retryDelayMs: 5_000,\r\n    sleep: (ms) => new Promise((r) => setTimeout(r, ms)),\r\n    parentStatus: adapterParentStatus,\r\n    buildMessage: adapterBuildMessage,\r\n    notifyUndeliverable: adapterNotify,\r\n    deliverToParent: adapterDeliver,\r\n    onDeliverError: (err) => {\r\n      if (!(err instanceof ParentChatDeliveryDeferredError)) reportBackgroundError('sub-agent-completion-push', err);\r\n    },\r\n  });\r\n}\r\n\r\nfunction adapterParentStatus(chatId: string): ParentStatus {\r\n  const chat = findChatById(chatId);\r\n  if (!chat) return { streaming: false, skip: 'missing_chat' };\r\n  if (hasManagedParent(chatId)) return { streaming: true, skip: null };\r\n  if (normalizeModeId(chat.modeId) === 'orchestrate') {\r\n    return { streaming: false, skip: 'orchestrate' };\r\n  }\r\n  return { streaming: isChatTurnInProgress(chatId), skip: null };\r\n}\r\n\r\nfunction foldRunToSubAgentRun(run: RunState): SubAgentRun {\r\n  const last = lastEndedAttempt(run);\r\n  const status =\r\n    run.phase === 'passed' ? 'completed' : run.phase === 'cancelled' ? 'cancelled' : 'failed';\r\n  return {\r\n    runId: run.runId,\r\n    type: run.type,\r\n    modelSource: run.modelSource,\r\n    resolvedModel: run.resolvedModel,\r\n    providerId: run.model?.providerId,\r\n    modelId: run.model?.id,\r\n    task: run.task,\r\n    title: run.title,\r\n    status,\r\n    parentChatId: run.parentChatId,\r\n    par