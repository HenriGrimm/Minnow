ow = document.createElement('div');\r\n    row.className = 'chat-history-pending__row';\r\n    row.style.setProperty('--chat-history-pending-w', `${76 - i * 10}%`);\r\n    root.appendChild(row);\r\n  }\r\n  return root;\r\n}\r\n\r\n/** Clear the transcript mount and show a pending marker synchronously so a switch never leaves another chat's bubbles visible during the history GET. */\r\nexport function paintChatTranscriptHistoryPending(mount?: string | HTMLElement): void {\r\n  const boardChatHost =\r\n    mount == null && isBoardChatEmbedOpenForChat(getActiveChat().id)\r\n      ? queryBoardChatTranscriptHost()\r\n      : null;\r\n  const mapChatHost = mount == null ? queryCodeMapChatHost(getActiveChat().id) : null;\r\n  const sharedHost = mount == null ? getSharedChatHost(getActiveChat().id)?.transcript : null;\r\n  const embeddedHost = sharedHost ?? boardChatHost ?? mapChatHost;\r\n  const area = embeddedHost ?? resolveChatMount(mount);\r\n  if (!area) return;\r\n  forgetChatSurface(area);\r\n  disposeChatWorkView(area);\r\n  const codeMount = boardChatHost != null || isCodeChatMount(mount);\r\n\r\n  if (codeMount && !embeddedHost && isMainColumnOverlaySuppressingChatDom()) {\r\n    return;\r\n  }\r\n\r\n  notifyManagedChatView(getActiveChat().id);\r\n\r\n  const boardGroup = codeMount && !embeddedHost ? getActiveBoardGroup() : null;\r\n  if (boardGroup?.viewMode === 'board') {\r\n    return;\r\n  }\r\n\r\n  cancelChatHistoryBackfill();\r\n  runWithChatMount(area, () => {\r\n    clearSubAgentCardDomRegistry();\r\n    clearTranscriptEmptyState(area);\r\n    area.classList.remove('chat-area--hub');\r\n    area.replaceChildren(buildChatHistoryPendingMarker());\r\n  });\r\n}\r\n\r\n/** Route pending transcript paint to the active foreground shell (Code / Chat app / desktop). */\r\nexport function paintChatHistoryPendingInForegroundShell(): void {\r\n  if (isChatAppForeground()) {\r\n    paintChatTranscriptHistoryPending('#chatAppMessageCol');\r\n    return;\r\n  }\r\n  if (\r\n    dismissCodeOverviewForNavigation() ||\r\n    dismissDevServerScreenForNavigation()\r\n  ) {\r\n    paintChatTranscriptHistoryPending();\r\n    return;\r\n  }\r\n  paintChatTranscriptHistoryPending();\r\n}\r\n\r\n// ── Transcript ───────────────────────────────────────────────────────────────\r\n\r\nexport function renderStatsForChat(chat: Chat): void {\r\n  refreshMetricsStripForChat(chat);\r\n  refreshContextUsageRing();\r\n  if (isHubMounted()) refreshHubLiveData();\r\n}\r\n\r\n/** Empty transcript for a board task that has not run yet. */\r\nfunction buildBoardChatEmptyState(): HTMLElement {\r\n  const wrap = document.createElement('div');\r\n  wrap.className = 'ob-chat__empty';\r\n  wrap.setAttribute('role', 'status');\r\n\r\n  const title = document.createElement('p');\r\n  title.className = 'ob-chat__empty-title';\r\n  title.textContent = 'This task has not started.';\r\n\r\n  const hint = document.createElement('p');\r\n  hint.className = 'ob-chat__empty-hint';\r\n  hint.textContent = 'Its transcript appears here once the board runs it.';\r\n\r\n  wrap.append(title, hint);\r\n  return wrap;\r\n}\r\n\r\ntype ToolResultLookup = Map<\r\n  string,\r\n  {\r\n    content: string;\r\n    attachments?: ToolResultMessage['attachments'];\r\n    codeChange?: ToolResultMessage['codeChange'];\r\n  }\r\n>;\r\n\r\ninterface HistoryRenderContext {\r\n  chat: Chat;\r\n  toolResultMap: ToolResultLookup;\r\n  /** Latest compaction checkpoint's fold, or null when the chat has none. */\r\n  fold: ReturnType<typeof compactionFoldView>;\r\n  presentation?: ChatTranscriptPresentation;\r\n}\r\n\r\nexport interface ChatTranscriptPresentation {\r\n  isThoughtExpanded: (key: string) => boolean;\r\n  onThoughtExpandedChange: (key: string, expanded: boolean) => void;\r\n  isToolExpanded: (id: string) => boolean;\r\n  onToolExpandedChange: (id: string, expanded: boolean) => void;\r\n  pendingToolStatus?: 'paused' | 'stopped';\r\n}\r\n\r\n/** The main chat's history rows, mounted independently of the active session. */\r\nexport function renderChatTranscriptHistory(\r\n  area: HTMLElement,\r\n  history: Message[],\r\n  identity: { id: string; modeId?: Chat['modeId'] },\r\n  presentation: ChatTranscriptPresentation,\r\n): void {\r\n  const chat: Chat = { ...identity, name: '', workspacePath: '', modelId: '', history,\r\n    updatedAt: 0, lastStats: null, modelInfo: {} };\r\n  const ctx = { ...historyRenderContext(chat), presentation };\r\n  const wasEmbedded = embeddedHistoryPaint;\r\n  const previousChat = embeddedHistoryChat;\r\n  const wasSuppressed = suppressBubbleScroll;\r\n  embeddedHistoryPaint = true;\r\n  embeddedHistoryChat = chat;\r\n  suppressBubbleScroll = true;\r\n  try {\r\n    area.replaceChildren();\r\n    runWithChatMount(area, () => {\r\n      for (let i = 0; i < history.length; i++) appendHistoryMessageAt(area, ctx, i);\r\n    });\r\n  } finally {\r\n    embeddedHistoryPaint = wasEmbedded;\r\n    embeddedHistoryChat = previousChat;\r\n    suppressBubbleScroll = wasSuppressed;\r\n  }\r\n}\r\n\r\nfunction historyRenderContext(chat: Chat): HistoryRenderContext {\r\n  const toolResultMap: ToolResultLookup = new Map();\r\n  for (const msg of chat.history) {\r\n    if (msg?.role !== 'tool') continue;\r\n    toolResultMap.set(msg.tool_call_id, {\r\n      content: msg.content,\r\n      attachments: msg.attachments,\r\n      ...(msg.codeChange ? { codeChange: msg.codeChange } : {}),\r\n    });\r\n  }\r\n  return { chat, toolResultMap, fold: compactionFoldView(chat.history) };\r\n}\r\n\r\n/** Show accepted input immediately without changing the runner's saved history. */\r\nfunction syncPendingUserMessages(chat: Chat, host: HTMLElement, messages: QueuedComposerMessage[]): void {\r\n  const ids = new Set(messages.map(item => item.id));\r\n  const mountedIds = new Set<string>();\r\n  for (const row of host.querySelectorAll<HTMLElement>('.msg--sending')) {\r\n    const id = row.dataset.pendingCommandId ?? '';\r\n    if (ids.has(id)) mountedIds.add(id);\r\n    else row.remove();\r\n  }\r\n  const statusRow = host.querySelector<HTMLElement>(':scope > .msg--sending-status');\r\n  for (const pending of messages) {\r\n    if (mountedIds.has(pending.id)) continue;\r\n    const message: UserMessage = { role: 'user', content: pending.text, provenance: pending.provenance, commandId: pending.id };\r\n    if (isHiddenTranscriptUserMessage(message)) continue;\r\n    if (isAttributedAgentMessage(message)) {\r\n      const row = createAttributedAgentMessage(chat, message, -1);\r\n      row.removeAttribute('data-history-index');\r\n      row.classList.add('msg--sending'); row.dataset.pendingCommandId = pending.id;\r\n      host.insertBefore(row, statusRow);\r\n      continue;\r\n    }\r\n    const wrap = document.createElement('div');\r\n    wrap.className = 'msg user msg--sending';\r\n    wrap.dataset.pendingCommandId = pending.id;\r\n    if (pending.kind !== 'steer') wrap.setAttribute('aria-busy', 'true');\r\n    const label = document.createElement('div');\r\n    label.className = 'msg-label';\r\n    label.textContent = pending.issue ? 'Issue' : 'You';\r\n    const bubble = document.createElement('div');\r\n    bubble.className = 'msg-bubble';\r\n    renderUserMessageBubble(bubble, pending.text, { persistedImages: pending.images, issue: pending.issue, codeMap: pending.codeMap });\r\n    wrap.append(label, bubble);\r\n    host.insertBefore(wrap, statusRow);\r\n  }\r\n}\r\n\r\n/** Keep the send status mounted while the accepted turn prepares its first response. */\r\nfunction syncSendingStatus(chat: Chat, host: HTMLElement, messages: QueuedComposerMessage[]): void {\r\n  let statusRow = host.querySelector<HTMLElement>(':scope > .msg--sending-status');\r\n  const pending = messages.find(item => item.kind !== 'steer');\r\n  const execution = chat.agentExecution;\r\n  const awaitingStream = statusRow?.dataset.chatId === chat.id && (chat.chatCommandVersion !== 1\r\n    ? isChatStreaming(chat.id)\r\n    : execution?.commandId === statusRow.dataset.pendingCommandId &&\r\n      (execution?.status === 'running' || execution?.status === 'loading_model'));\r\n  if ((!pending && !awaitingStream) || host.querySelector(':scope > .msg.assistant[data-stream-phase]:not([data-stream-phase=\"done\"])')) {\r\n    statusRow?.remove();\r\n    return;\r\n  }\r\n  if (!statusRow) {\r\n    statusRow = document.createElement('div');\r\n    statusRow.className = 'msg assistant msg--sending-status';\r\n    statusRow.dataset.chatId = chat.id;\r\n    const label = document.createElement('div');\r\n    label.className = 'msg-label';\r\n    label.textContent = 'Assistant';\r\n    statusRow.append(label, createStreamStatusElement('Sending…'));\r\n    host.append(statusRow);\r\n  }\r\n  if (pending) statusRow.dataset.pendingCommandId = pending.id;\r\n}\r\n\r\n/** Update accepted messages without rebuilding the assistant's streaming DOM. */\r\nexport function syncPendingTranscriptMessages(chat: Chat, host = getActiveChatMountElement()): void {\r\n  if (!host || getActiveChat().id !== chat.id) return;\r\n  const messages = getPendingTranscriptMessages(chat);\r\n  syncPendingUserMessages(chat, host, messages);\r\n  syncSendingStatus(chat, host, messages);\r\n}\r\n\r\n/** Paint the shared transcript in a secondary surface without selecting or repainting Code. */\r\nexport function renderEmbeddedChatTranscript(chat: Chat, area: HTMLElement, expanded: Set<number>, presentation?: ChatTranscriptPresentation, isStreaming = () => isChatStreaming(chat.id)): { dispose: () => void } {\r\n  disposeChatWorkView(area);\r\n  const host = document.createElement('div');\r\n  const ctx = { ...historyRenderContext(chat), presentation };\r\n  const tailStart = Math.min(Math.max(0, chat.history.length - HISTORY_SYNC_TAIL), retainedChatHistoryStart(area, chat) ?? Infinity);\r\n  const syncWorkView = () => installChatWorkView(area, chat, isStreaming, { expanded, isolated: true });\r\n  function paint(target: HTMLElement, callback: () => void): void {\r\n    const wasSuppressed = suppressBubbleScroll;\r\n    const wasEmbedded = embeddedHistoryPaint;\r\n    const previousChat = embeddedHistoryChat;\r\n    suppressBubbleScroll = true;\r\n    embeddedHistoryPaint = true;\r\n    embeddedHistoryChat = chat;\r\n    try { runWithChatMount(target, callback); }\r\n    finally {\r\n      suppressBubbleScroll = wasSuppressed;\r\n      embeddedHistoryPaint = wasEmbedded;\r\n      embeddedHistoryChat = previousChat;\r\n    }\r\n  }\r\n  paint(host, () => {\r\n    for (let i = tailStart; i < chat.history.length; i += 1) appendHistoryMessageAt(host, ctx, i);\r\n    const messages = getPendingTranscriptMessages(chat);\r\n    syncPendingUserMessages(chat, host, messages);\r\n    syncSendingStatus(chat, host, messages);\r\n  });\r\n  area.replaceChildren(...host.childNodes);\r\n  syncWorkView();\r\n  const cancelBackfill = mountHistoryPager({ mount: area, from: tailStart,\r\n    scrollRoot: () => area.parentElement,\r\n    renderRow: (row, index) => paint(row, () => appendHistoryMessageAt(row, ctx, index)),\r\n    onPageLoaded: syncWorkView,\r\n  });\r\n  rememberChatSurface(area, chat);\r\n  return { dispose: () => { cancelBackfill(); disposeChatWorkView(area); } };\r\n}\r\n\r\n/**\r\n * Render one history entry into `host`. Split out of `renderChatFromHistory` so the transcript\r\n * can be built in chunks across frames instead of one unbroken task (MIN-793).\r\n * Caller must already be inside `runWithChatMount(host, …)`.\r\n */\r\nfunction appendHistoryMessageAt(host: HTMLElement, ctx: HistoryRenderContext, i: number): void {\r\n  const { fold } = ctx;\r\n  const msg = ctx.chat.history[i];\r\n  if (!fold || !msg || msg.role === 'context' || i > fold.foldThrough || i === fold.pinnedIndex) {\r\n    appendHistoryMessageRowAt(host, ctx, i);\r\n    return;\r\n  }\r\n  // Folded by the latest checkpoint: still rendered, labeled as out of the model context.\r\n  const before = host.children.length;\r\n  appendHistoryMessageRowAt(host, ctx, i);\r\n  for (let k = before; k < host.children.length; k += 1) markOutOfContext(host.children[k]);\r\n}\r\n\r\nfunction appendHistoryMessageRowAt(host: HTMLElement, ctx: HistoryRenderContext, i: number): void {\r\n  const { chat, toolResultMap } = ctx;\r\n  const msg = chat.history[i];\r\n  if (!msg || !msg.role) return;\r\n  if (msg.role === 'tool') return;\r\n  const attachActions: typeof attachMessageActions = (...args) => {\r\n    if (!ctx.presentation) attachMessageActions(...args);\r\n  };\r\n  const thoughts = ctx.presentation ? {\r\n    expanded: ctx.presentation.isThoughtExpanded(String(i)),\r\n    onExpandedChange: (expanded: boolean) => ctx.presentation?.onThoughtExpandedChange(String(i), expanded),\r\n  } : {};\r\n\r\n  if (msg.role === 'context') {\r\n    if (isCompactionNotice(msg)) {\r\n      host.appendChild(\r\n        createCompactionDivider(msg, {\r\n          historyIndex: i,\r\n          superseded: ctx.fold != null && ctx.fold.checkpointIndex !== i,\r\n        }),\r\n      );\r\n      return;\r\n    }\r\n    appendContextNotice(host, msg as ContextNoticeMessage, i);\r\n    return;\r\n  }\r\n\r\n  if (msg.role === 'injection') {\r\n    appendInjectionNotice(host, msg as InjectionNoticeMessage, i);\r\n    return;\r\n  }\r\n\r\n  if (msg.role === 'user') {\r\n    const userMsg = msg;\r\n    if (isHiddenTranscriptUserMessage(userMsg)) {\r\n      return;\r\n    }\r\n    if (isAttributedAgentMessage(userMsg)) { host.append(createAttributedAgentMessage(chat, userMsg, i)); return; }\r\n    const { wrap } = appendBubble('user', apiMessageContentToText(userMsg.content), {\r\n      historyIndex: i,\r\n      turnKind: 'user',\r\n      chatId: chat.id,\r\n      modeId: chat.modeId,\r\n    }, { renderFromHistory: true, persistedImages: userMsg.images, issue: userMsg.issue, codeMap: userMsg.codeMap, steer: userMsg.steer });\r\n    if (userMsg.goalAchieved) {\r\n      restoreGoalAchievedAffordance(wrap, userMsg);\r\n    }\r\n    attachActions(wrap, {\r\n      chatId: chat.id,\r\n      historyIndex: i,\r\n      turnKind: 'user',\r\n    });\r\n    if (!ctx.presentation) attachBranchPicker(wrap, chat.id, i);\r\n    return;\r\n  }\r\n\r\n  if (isAssistantToolCallMessage(msg)) {\r\n    const prose = msg.content != null ? String(msg.content).trim() : '';\r\n    const toolThinking =\r\n      msg.thinking != null && msg.thinking.length > 0 ? msg.thinking : undefined;\r\n    const hasToolThinking = toolThinking != null && toolThinking.length > 0;\r\n    const summaryTitle = toolCallSummaryTitle(toolThinking ?? [], msg.reasoningFormat);\r\n    if (prose || hasToolThinking && !summaryTitle) {\r\n      const { wrap, bubble } = appendBubble('assistant', prose, {\r\n        historyIndex: i,\r\n        turnKind: 'assistant-tools',\r\n        chatId: chat.id,\r\n        modeId: chat.modeId,\r\n      });\r\n      if (!prose && hasToolThinking) {\r\n        bubble.remove();\r\n      }\r\n      if (hasToolThinking && !summaryTitle) {\r\n        const durationMs = msg.thinkingDurationMs;\r\n        renderThoughtsToggle(wrap, toolThinking!, {\r\n          reasoningFormat: msg.reasoningFormat,\r\n          ...thoughts,\r\n          durationMs: durationMs != null && durationMs > 0 ? durationMs : undefined,\r\n        });\r\n      }\r\n      if (msg.stats || msg.usage) {\r\n        appendStats(wrap, msg.stats || {}, msg.usage || {});\r\n      }\r\n      if (msg.stopped) {\r\n        markMessageStopped(wrap);\r\n      }\r\n      attachActions(wrap, {\r\n        chatId: chat.id,\r\n        historyIndex: i,\r\n        turnKind: 'assistant-tools',\r\n      });\r\n    }\r\n    const stoppedNeedsMarkerRow = Boolean(msg.stopped) && !prose && (!hasToolThinking || Boolean(summaryTitle));\r\n\r\n    let firstToolEl: HTMLElement | null = null;\r\n    const toolItems: ToolCallBatchItem[] = [];\r\n    for (const tc of msg.tool_calls) {\r\n      const argsObj = parseToolArgsForDisplay(tc.function.arguments);\r\n      const 