= hash.match(/^#\\/app\\/code\\/chat\\?([^#]*)$/);\r\n  if (!match) return null;\r\n  const ids = new URLSearchParams(match[1]).getAll('chatId');\r\n  return ids.length === 1 && /^[A-Za-z0-9_-]{1,160}$/.test(ids[0]!) ? ids[0]! : null;\r\n}\r\n"]}}