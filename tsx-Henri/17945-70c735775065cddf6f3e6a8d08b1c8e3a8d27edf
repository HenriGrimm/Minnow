AK,UAAU,EACnK,MAAM,cAAgB,iCAAiC,MAAM,EAC7D,MAAM,WAAa,iBAAiB,IAAI,EACxC,OAAO,qBAAqB,WAAY,OAAQ,aAAa,CAC/D,CARgB,oDAcT,SAAS,sBACd,QACA,eACA,KACiB,CACjB,GAAI,MAAM,aAAc,OAAO,+BAA+B,IAAI,EAClE,MAAO,OAAO,KAAM,KAAM,cAAgB,CACxC,OAAO,YAAY,KAAM,KAAM,CAC7B,GAAG,YACH,OAAQ,aAAa,QAAU,WAC/B,aAAc,OACd,OAAQ,aAAa,QAAU,OACjC,CAAC,CACH,CACF,CAdgB","names":[],"ignoreList":[],"sources":["C:\\Users\\dukky\\Documents\\Development\\Minnow\\src\\evals\\tool-context.ts"],"sourcesContent":["/**\r\n * Build eval tool allowlist and executeTool wrapper for isolated runs.\r\n */\r\n\r\nimport { resolveSubAgentTools } from '../agents/sub-agent-tools';\r\nimport type { SubAgentTypeConfig } from '../agents/types';\r\nimport { getEnabledToolDefinitionsForMode } from '../tools/client';\r\nimport { executeTool } from '../tools/client';\r\nimport type { OpenAIFunctionDefinition } from '../tools/definitions';\r\nimport type { EvalConfig, EvalTask } from './types';\r\nimport type { ToolExecutionResult } from '../types';\r\nimport { BUILT_IN_TOOLS } from '../tools/definitions';\r\nimport { createScriptedEvalToolExecutor, type EvalFixtureReport } from './tool-fixtures';\r\n\r\n/** Synthetic sub-agent config from task allow/deny lists. */\r\nfunction taskToTypeConfig(task: EvalTask): SubAgentTypeConfig {\r\n  return {\r\n    enabled: true,\r\n    providerId: '',\r\n    modelId: '',\r\n    maxConcurrent: 1,\r\n    workAgentId: null,\r\n    allowedTools: task.allowedTools.length > 0 ? task.allowedTools : null,\r\n    deniedTools: task.deniedTools,\r\n    systemPromptPath: null,\r\n  };\r\n}\r\n\r\n/** Resolve OpenAI tool defs for an eval task (Build mode baseline). */\r\nexport function resolveEvalTaskTools(\r\n  task: EvalTask,\r\n  modeId = 'build',\r\n): OpenAIFunctionDefinition[] {\r\n  if (task.toolFixtures) return BUILT_IN_TOOLS.filter(tool => task.allowedTools.includes(tool.id) && !task.deniedTools.includes(tool.id)).map(tool => tool.definition);\r\n  const parentEnabled = getEnabledToolDefinitionsForMode(modeId);\r\n  const typeConfig = taskToTypeConfig(task);\r\n  return resolveSubAgentTools(typeConfig, 'eval', parentEnabled);\r\n}\r\n\r\n/** Execute tool during eval with optional approval skip. */\r\nexport type EvalExecuteTool = ((\r\n  name: string, args: Record<string, unknown>, toolContext?: import('../tools/client').ExecuteToolContext,\r\n) => Promise<ToolExecutionResult>) & { fixtureReport?(): EvalFixtureReport };\r\nexport function createEvalExecuteTool(\r\n  _config: EvalConfig,\r\n  _workspacePath: string,\r\n  task?: EvalTask,\r\n): EvalExecuteTool {\r\n  if (task?.toolFixtures) return createScriptedEvalToolExecutor(task);\r\n  return async (name, args, toolContext) => {\r\n    return executeTool(name, args, {\r\n      ...toolContext,\r\n      chatId: toolContext?.chatId ?? 'eval-run',\r\n      subAgentType: 'eval',\r\n      modeId: toolContext?.modeId ?? 'build',\r\n    });\r\n  };\r\n}\r\n"]}}