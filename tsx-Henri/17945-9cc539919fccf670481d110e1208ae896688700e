ranch?: string;\r\n  targetBranch?: string;\r\n  sourceHead?: string;\r\n  targetHead?: string;\r\n  fingerprint?: string;\r\n  message?: string;\r\n  cleanup?: boolean;\r\n  sha?: string;\r\n}\r\n\r\nexport async function issueWorkOperation(\r\n  action: 'Inspect' | 'Commit' | 'Merge' | 'Cleanup',\r\n  input: IssueWorkRequest,\r\n): Promise<IssueWorkSnapshot> {\r\n  const op = `issueWork${action}`;\r\n  const result = await postGit(op, input as unknown as Record<string, unknown>) as unknown as IssueWorkSnapshot;\r\n  if (!result.ok && result.error === `Unknown git op: ${op}`) {\r\n    return { ok: false, error: 'The running Minnow server does not support issue work operations. Restart Minnow (including the tool server), then refresh this tab.' };\r\n  }\r\n  return result;\r\n}\r\n\r\nexport interface GitCommitEntry {\r\n  hash: string;\r\n  parents: string[];\r\n  subject: string;\r\n  author: string;\r\n  relativeTime: string;\r\n  refs: string[];\r\n}\r\n\r\nexport interface GitCommitSnapshot {\r\n  headSha: string | null;\r\n  branch: string | null;\r\n  treeSha: string;\r\n}\r\n\r\nexport interface GitOpResult {\r\n  needsChoice?: boolean;\r\n  fileCount?: number;\r\n  savedChanges?: GitSavedCheckoutChanges[];\r\n  additions?: number;\r\n  deletions?: number;\r\n  ok: boolean;\r\n  error?: string;\r\n  branch?: string;\r\n  ahead?: number;\r\n  behind?: number;\r\n  staged?: GitFileEntry[];\r\n  unstaged?: GitFileEntry[];\r\n  untracked?: GitFileEntry[];\r\n  /** Unmerged paths; retained in the legacy staged/unstaged buckets for older consumers. */\r\n  conflicted?: GitFileEntry[];\r\n  operation?: 'merge' | 'rebase' | 'cherry-pick';\r\n  patch?: string;\r\n  sha?: string;\r\n  /** `stage`: pathspecs actually handed to `git add`. */\r\n  stagedPaths?: string[];\r\n  /** `stage`: pathspecs dropped because they are neither tracked nor on disk (MIN-651). */\r\n  skippedPaths?: string[];\r\n  /** HEAD tip when a snapshot was created/restored (MIN-409). */\r\n  hea