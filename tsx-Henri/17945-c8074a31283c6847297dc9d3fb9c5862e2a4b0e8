rn JSON.stringify({ issue_id: issueId, status: updated.status, rank: updated.rank }, null, 2);\r\n}\r\n\r\n// ── Execute ──────────────────────────────────────────────────────────────────\r\n\r\n/** Execute one of the v2 issue tools. */\r\nexport async function executeIssueV2Tool(\r\n  name: string,\r\n  args: Record<string, unknown>,\r\n): Promise<string> {\r\n  switch (name) {\r\n    case 'issue_search':\r\n      return runSearch(args);\r\n    case 'issue_comment':\r\n      return runComment(args);\r\n    case 'issue_assign':\r\n      return runAssign(args);\r\n    case 'issue_unlink':\r\n      return runUnlink(args);\r\n    case 'issue_move':\r\n      return runMove(args);\r\n    default:\r\n      return `Error: unknown issue tool \"${name}\"`;\r\n  }\r\n}\r\n"]}}