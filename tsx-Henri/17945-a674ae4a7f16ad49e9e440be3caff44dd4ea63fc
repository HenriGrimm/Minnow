AI,MAAQ,EAAG,MAAO,GAAG,MAAM,MAAM,KAAK,SAC1C,OAAO,MACT,CAPgB,0DAUT,SAAS,uBAAuB,OAAgB,KAA6B,CAClF,MAAM,KAAO,aAAa,MAAM,EAChC,GAAI,CAAC,KAAM,OAEX,MAAM,MAAQ,KAAK,MAAM,KAAK,GAAK,OACnC,MAAM,KAAO,wBAAwB,IAAI,EACzC,MAAM,QAAU,KAAK,OAAO,KAAK,EAAI,GAAG,KAAK,MAAM,KAAK,CAAC,WAAM,IAAI,GAAK,KAExE,iBAAiB,CACf,KAAM,gBACN,MACA,QACA,OACA,MAAO,aAAa,IAAI,EACxB,UAAW,YAAY,OAAQ,IAAI,EACnC,GAAI,IACN,CAAC,CACH,CAjBgB","names":[],"ignoreList":[],"sources":["C:\\Users\\dukky\\Documents\\Development\\Minnow\\src\\notifications\\ask-question.ts"],"sourcesContent":["/**\r\n * Notification producer when ask_question UI opens — always alerts so the user\r\n * notices even when the chat is on screen but they are not looking.\r\n */\r\n\r\nimport { findChatById } from '../state/sessions';\r\nimport type { AskQuestionArgs } from '../tools/ask-question-types';\r\nimport { appIdForChat } from './app-for-chat';\r\nimport { truncatePreview } from './preview';\r\nimport { pushNotification } from './push';\r\nimport { resolveQuestionNotification } from './store';\r\n\r\nfunction questionKey(chatId: string, args: AskQuestionArgs): string {\r\n  return `ask:${chatId}:${args.questions.map((q) => q.id).join(',')}`;\r\n}\r\n\r\n/** Clear the alert when its question strip is answered or cancelled. */\r\nexport function notifyAskQuestionFinished(chatId: string, args: AskQuestionArgs): void {\r\n  resolveQuestionNotification(chatId, questionKey(chatId, args));\r\n}\r\n\r\n/** Build a compact preview from the first question (and count when batched). */\r\nexport function buildAskQuestionPreview(args: AskQuestionArgs): string {\r\n  const first = args.questions[0];\r\n  if (!first?.prompt?.trim()) return 'Answer required';\r\n  const prompt = truncatePreview(first.prompt);\r\n  const extra = args.questions.length - 1;\r\n  if (extra > 0) return `${prompt} (+${extra} more)`;\r\n  return prompt;\r\n}\r\n\r\n/** Push inbox row + bell/sound whenever ask_question opens (Super Plan grill, etc.). */\r\nexport function notifyAskQuestionShown(chatId: string, args: AskQuestionArgs): void {\r\n  const chat = findChatById(chatId);\r\n  if (!chat) return;\r\n\r\n  const title = chat.name?.trim() || 'Chat';\r\n  const body = buildAskQuestionPreview(args);\r\n  const preview = args.title?.trim() ? `${args.title.trim()} — ${body}` : body;\r\n\r\n  pushNotification({\r\n    kind: 'chat_question',\r\n    title,\r\n    preview,\r\n    chatId,\r\n    appId: appIdForChat(chat),\r\n    dedupeKey: questionKey(chatId, args),\r\n    os: true,\r\n  });\r\n}\r\n"]}}